<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 Dynamic Colors Theme -->
    <style name="Theme.App" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/md_ref_pal_surface_container_highest</item>
        <item name="android:windowLightNavigationBar">?attr/isLightTheme</item>
        
        <!-- Window background -->
        <item name="android:windowBackground">@color/md_ref_pal_surface</item>
        
        <!-- Enable edge-to-edge -->
        <item name="android:fitsSystemWindows">false</item>
    </style>
    
    <!-- Light theme override -->
    <style name="Theme.App.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/md_ref_pal_surface_container_highest</item>
        <item name="android:windowBackground">@color/md_ref_pal_surface</item>
    </style>
    
    <!-- Dark theme override -->
    <style name="Theme.App.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/md_ref_pal_surface_container_highest</item>
        <item name="android:windowBackground">@color/md_ref_pal_surface</item>
    </style>
</resources>
