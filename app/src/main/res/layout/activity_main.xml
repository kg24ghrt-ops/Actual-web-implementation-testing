<?xml version="1.0" encoding="utf-8"?>
<!--
    Modern Full-Screen Notebook Paper Layout
    Material Design 3 with edge-to-edge display
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_surface"
    android:fitsSystemWindows="true">

    <!-- Full-screen Lined Paper Editor -->
    <com.opt.nohomework.view.LinedPaperEditText
        android:id="@+id/linedPaperEditor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="top|start"
        android:inputType="textMultiLine|textNoSuggestions"
        android:imeOptions="flagNoExtractUi"
        android:scrollbars="vertical"
        android:overScrollMode="always" />

    <!-- Bottom Sheet Controls -->
    <include
        android:id="@+id/bottomSheet"
        layout="@layout/bottom_sheet_controls"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior" />

    <!-- Export FAB -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabExport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:layout_marginBottom="80dp"
        android:text="Export"
        app:icon="@android:drawable/ic_menu_save"
        app:backgroundTint="@color/md_theme_primary"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior" />

    <!-- Share FAB -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabShare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:layout_marginBottom="140dp"
        android:text="Share"
        app:icon="@android:drawable/ic_menu_share"
        app:backgroundTint="@color/md_theme_secondary"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
